@startuml
!include ../styl.iuml
left to right direction
class startup <<moduł, NXP SDK>> {
  +g_pfnVectors[]
  +ResetISR()
  -data_init(romstart, start, len)
  -bss_init(start, len)
}
class main_cpp <<moduł>> {
  +main() : int
}
class init_cpp <<moduł>> {
  +kernel_main()
  -print_reset_cause()
}
class boot_cpp <<moduł>> {
  -driver bus_driver
  -driver usdhc_driver
  -driver earlycon_driver
  +boot_start()
  +boot_setup_devices(dtb, dir) : int
  -boot_thread(arg)
  -mount_sd()
  -safe_mode_requested() : bool
  -load_device_tree(dtb) : int
  -autoload_modules(dir)
  -start_init()
}
class autoload <<struct>> {
  +alias aliases[64]
  +int naliases
  +const char* pending[16]
  +int npending
  +const char* tried[64]
  +int ntried
}
class alias <<struct>> {
  +const char* compatible
  +const char* module
}
startup ..> main_cpp : main()
main_cpp ..> init_cpp : kernel_main()
init_cpp ..> boot_cpp : boot_start()
boot_cpp ..> autoload
autoload *-- alias
@enduml
