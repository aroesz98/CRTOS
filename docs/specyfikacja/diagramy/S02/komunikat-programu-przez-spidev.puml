@startuml
!include ../styl.iuml
autonumber
participant "program (ioctl)" as P
participant "K09 sys_ioctl" as S
participant "spidev_message" as M
participant "spi_sync" as Y
participant "lpspi-imxrt (D02)" as C
P -> S : ioctl(fd, SPI_IOC_MESSAGE(2), t)
S -> S : uaccess_ok(t, 2 x 32 B)
S -> M : spidev_ioctl
M -> M : długości (<= 16 KB), uaccess_ok(tx_buf, rx_buf) każdej części
M -> M : bufor jądra 2 x suma: kopia tx (albo zera)
M -> Y : spi_sync(spi, części jądra)
Y -> Y : mutex kontrolera
Y -> C : transfer(ctx, spi, części)
C --> Y : 0
M -> M : kopia odebranych danych do rx_buf programu
M --> P : liczba bajtów
@enduml
