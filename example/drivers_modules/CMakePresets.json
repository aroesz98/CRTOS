{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "ARM Cortex-M7 Release",
            "description": "Build all driver modules for CRTOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_UART_DRIVER": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "ARM Cortex-M7 Debug",
            "description": "Build driver modules with debug symbols",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_UART_DRIVER": "ON"
            }
        },
        {
            "name": "all-drivers",
            "displayName": "All Drivers",
            "description": "Build all available driver modules",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-all",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_UART_DRIVER": "ON",
                "BUILD_SPI_DRIVER": "ON",
                "BUILD_I2C_DRIVER": "ON",
                "BUILD_GPIO_DRIVER": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "description": "Build release modules"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "description": "Build debug modules"
        },
        {
            "name": "all-drivers",
            "configurePreset": "all-drivers",
            "description": "Build all drivers"
        }
    ]
}
