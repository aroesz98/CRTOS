{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "ARM Cortex-M7 Release",
            "description": "Build UART driver module for CRTOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "ARM Cortex-M7 Debug",
            "description": "Build UART driver module with debug symbols",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "description": "Build release module"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "description": "Build debug module"
        }
    ]
}
