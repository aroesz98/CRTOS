@@ -1003,8 +1003,9 @@ tcp_recved(struct tcp_pcb *pcb, u16_t len)
     tcp_output(pcb);
   }
 
+  /* CRTOS change: tcpwnd_size_t, not u16_t (32 bits with LWIP_WND_SCALE, as the format says) */
   LWIP_DEBUGF(TCP_DEBUG, ("tcp_recved: received %"U16_F" bytes, wnd %"TCPWNDSIZE_F" (%"TCPWNDSIZE_F").\n",
