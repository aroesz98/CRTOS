diff --git a/src/api/sockets.c b/src/api/sockets.c
index d5dacf4..61a2d2d 100644
--- a/src/api/sockets.c
+++ b/src/api/sockets.c
@@ -2606,6 +2606,14 @@ event_callback(struct netconn *conn, enum netconn_evt evt, u16_t len)
   } else {
     SYS_ARCH_UNPROTECT(lev);
   }
+#ifdef LWIP_HOOK_CRTOS_SOCKET_EVENT
+  /* CRTOS change: the kernel waits for sockets itself (and wakes poll()) - told only of the
+   * events that can let a waiting call go on (data or room after none, an error), like the
+   * select() waiters above; the others (one at every segment) cost a tenth of the processor */
+  if (check_waiters) {
+    LWIP_HOOK_CRTOS_SOCKET_EVENT(s);
+  }
+#endif
   done_socket(sock);
 }
 
diff --git a/src/core/tcp.c b/src/core/tcp.c
