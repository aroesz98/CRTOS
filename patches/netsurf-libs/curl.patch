diff --git a/lib/vtls/mbedtls.c b/lib/vtls/mbedtls.c
index e071ded..20116e1 100644
--- a/lib/vtls/mbedtls.c
+++ b/lib/vtls/mbedtls.c
@@ -90,6 +90,7 @@ struct mbed_ssl_backend_data {
   mbedtls_entropy_context entropy;
   mbedtls_ssl_context ssl;
   mbedtls_x509_crt cacert;
+  mbedtls_x509_crt *ca_chain; /* CRTOS: the shared CA certificates, or NULL */
   mbedtls_x509_crt clicert;
 #ifdef MBEDTLS_X509_CRL_PARSE_C
   mbedtls_x509_crl crl;
@@ -122,6 +123,45 @@ struct mbed_ssl_backend_data {
 #define HAS_SESSION_TICKETS
 #endif
 
+#if defined(__CRTOS__) && defined(MBEDTLS_FS_IO)
+/* CRTOS: the trusted CA file is parsed once and its certificates shared by
+   all connections (they run in one thread). Parsing a bundle of some 120
+   certificates for every connection costs tens of milliseconds and a few
+   hundred KB of memory each. */
+#define CA_SHARED
+static mbedtls_x509_crt ca_shared;
+static char *ca_shared_file;
+
+static mbedtls_x509_crt *ca_shared_get(const char *file, int *err)
+{
+  *err = 0;
+  if(ca_shared_file && !strcmp(ca_shared_file, file))
+    return &ca_shared;
+  if(ca_shared_file) {
+    mbedtls_x509_crt_free(&ca_shared);
+    Curl_safefree(ca_shared_file);
+  }
+  mbedtls_x509_crt_init(&ca_shared);
+  *err = mbedtls_x509_crt_parse_file(&ca_shared, file);
+  if(*err >= 0) {
+    ca_shared_file = strdup(file);
+    if(ca_shared_file)
+      return &ca_shared;
+    *err = MBEDTLS_ERR_X509_ALLOC_FAILED;
+  }
+  mbedtls_x509_crt_free(&ca_shared);
+  return NULL;
+}
+
+static void ca_shared_free(void)
+{
+  if(ca_shared_file) {
+    mbedtls_x509_crt_free(&ca_shared);
+    Curl_safefree(ca_shared_file);
+  }
+}
+#endif
+
 #ifdef THREADING_SUPPORT
 static mbedtls_entropy_context ts_entropy;
 
@@ -612,6 +652,7 @@ mbed_connect_step1(struct Curl_cfilter *cf, struct Curl_easy *data)
 
   /* Load the trusted CA */
   mbedtls_x509_crt_init(&backend->cacert);
+  backend->ca_chain = NULL;
 
   if(ca_info_blob && verifypeer) {
     /* Unfortunately, mbedtls_x509_crt_parse() requires the data to be null
@@ -634,6 +675,11 @@ mbed_connect_step1(struct Curl_cfilter *cf, struct Curl_easy *data)
 
   if(ssl_cafile && verifypeer) {
 #ifdef MBEDTLS_FS_IO
+#ifdef CA_SHARED
+    if(!ssl_capath)
+      backend->ca_chain = ca_shared_get(ssl_cafile, &ret);
+    else
+#endif
     ret = mbedtls_x509_crt_parse_file(&backend->cacert, ssl_cafile);
 
     if(ret < 0) {
@@ -901,6 +947,7 @@ mbed_connect_step1(struct Curl_cfilter *cf, struct Curl_easy *data)
   }
 
   mbedtls_ssl_conf_ca_chain(&backend->config,
+                            backend->ca_chain ? backend->ca_chain :
                             &backend->cacert,
 #ifdef MBEDTLS_X509_CRL_PARSE_C
                             &backend->crl);
@@ -1307,6 +1354,7 @@ static void mbedtls_close(struct Curl_cfilter *cf, struct Curl_easy *data)
     mbedtls_pk_free(&backend->pk);
     mbedtls_x509_crt_free(&backend->clicert);
     mbedtls_x509_crt_free(&backend->cacert);
+    backend->ca_chain = NULL;
 #ifdef MBEDTLS_X509_CRL_PARSE_C
     mbedtls_x509_crl_free(&backend->crl);
 #endif
@@ -1580,6 +1628,9 @@ static int mbedtls_init(void)
 
 static void mbedtls_cleanup(void)
 {
+#ifdef CA_SHARED
+  ca_shared_free();
+#endif
 #ifdef THREADING_SUPPORT
   entropy_cleanup_mutex(&ts_entropy);
 #endif
