 }
 
 
+/* exported interface documented in image/image.h */
+unsigned int image_decode_scale_extra(unsigned int width, unsigned int height,
+		size_t extra)
+{
+	unsigned int scale = 1;
+#ifdef NETSURF_IMAGE_MAX_BYTES
+	while (scale <= 8 &&
+	       extra + (unsigned long long)((width + scale - 1) / scale) *
+	       ((height + scale - 1) / scale) * 4 > NETSURF_IMAGE_MAX_BYTES) {
+		scale *= 2;
+	}
+	if (scale > 8 && extra > 0) {
+		/* over the budget at any size: at least do not make the
+		 * picture worse than the bitmap alone requires */
+		return image_decode_scale_extra(width, height, 0);
+	}
+	if (scale > 8) {
+		scale = 8;
+	}
+#else
+	(void)width;
+	(void)height;
+	(void)extra;
+#endif
+	return scale;
+}
+
+/* exported interface documented in image/image.h */
+unsigned int image_decode_scale(unsigned int width, unsigned int height)
+{
+	return image_decode_scale_extra(width, height, 0);
+}
