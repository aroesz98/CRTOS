+/**
+ * Memory the decoder of a progressive JPEG holds for the whole image: the DCT
+ * coefficients of every block of every component (a sequential one decodes
+ * row by row).
+ */
+static size_t nsjpeg_coef_bytes(const struct jpeg_decompress_struct *cinfo)
+{
+	size_t bytes = 0;
+	int ci;
+
+	if (!cinfo->progressive_mode) {
+		return 0;
+	}
+	for (ci = 0; ci < cinfo->num_components; ci++) {
+		const jpeg_component_info *comp = &cinfo->comp_info[ci];
+		bytes += (size_t)comp->width_in_blocks *
+			comp->height_in_blocks * sizeof(JBLOCK);
+	}
+	return bytes;
+}
