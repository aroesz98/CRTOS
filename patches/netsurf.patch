+	if (pstyle->stroke_type != PLOT_OP_TYPE_NONE) {
+		nsfb_plot_pen_t pen;
+		/* the width scales with the transform (its area factor) */
+		float scale = sqrtf(fabsf(transform[0] * transform[3] -
+					  transform[1] * transform[2]));
+		int width = (int)(plot_style_fixed_to_float(pstyle->stroke_width) *
+				  scale + 0.5f);
+
+		pen.stroke_type = NFSB_PLOT_OPTYPE_SOLID;
+		pen.stroke_colour = pstyle->stroke_colour;
+		pen.stroke_width = width > 0 ? width : 1;
+		flat_path_stroke(&fp, &pen);
+	}
+
+out:
+	free(fp.xy);
+	free(fp.start);
+	free(fp.closed);
+	return res;
