+	}
+
+	if (pstyle->fill_type != PLOT_OP_TYPE_NONE) {
+		if (!flat_path_fill(&fp, pstyle->fill_colour)) {
+			res = NSERROR_NOMEM;
+			goto out;
+		}
+	}
