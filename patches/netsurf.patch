+/* Scroll a writable text so that its caret is in view, and away from the
+ * edges where the text allows it (a tap near an edge then moves on).
+ */
+static void
+text_scroll_to_caret(fbtk_widget_t *widget, int border)
+{
+	int visible = widget->width - border - border;
+	int margin = visible / 5;
+	int pos = widget->u.text.idx_offset - widget->u.text.scroll;
+	int max = widget->u.text.width + 1 - visible; /* the end in view */
+
+	if (pos > visible - 1 - margin) {
+		widget->u.text.scroll = widget->u.text.idx_offset -
+				(visible - 1 - margin);
+	} else if (pos < margin) {
+		widget->u.text.scroll = widget->u.text.idx_offset - margin;
+	}
+	if (widget->u.text.scroll > max)
+		widget->u.text.scroll = max;
+	if (widget->u.text.scroll < 0)
+		widget->u.text.scroll = 0;
+}
+
+/* Put the caret of a writable text at the character nearest to x (relative
+ * to the widget, as shown), scrolling the text to keep the caret in view.
+ */
+static void
+text_caret_at(fbtk_widget_t *widget, int x)
+{
+	plot_font_style_t font_style;
+	int fh;
+	int border;
+	size_t idx;
+
+	fb_text_font_style(widget, &fh, &border, &font_style);
+
+	fb_font_position(&font_style, widget->u.text.text,
+			widget->u.text.len,
+			x - border + widget->u.text.scroll,
+			&idx,
+			&widget->u.text.idx_offset);
+	widget->u.text.idx = idx;
+	text_scroll_to_caret(widget, border);
+	fbtk_set_caret(widget, true,
+			widget->u.text.idx_offset + border,
+			border,
+			widget->height - border - border,
+			fb_text_input_remove_caret_cb);
+
+	fbtk_request_redraw(widget);
+}
