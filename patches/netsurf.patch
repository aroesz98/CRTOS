+/**
+ * A path flattened to straight lines: the points of all its subpaths, in
+ * screen coordinates, and where each subpath starts.
+ */
+struct flat_path {
+	float *xy;		/**< x, y of each point */
+	unsigned int npoints;
+	unsigned int point_alloc;
+	unsigned int *start;	/**< first point of each subpath */
+	bool *closed;		/**< subpath ends with a close command */
+	unsigned int nsub;
+	unsigned int sub_alloc;
+};
+
+static bool flat_path_point(struct flat_path *fp, float x, float y)
+{
+	if (fp->npoints == fp->point_alloc) {
+		unsigned int alloc = fp->point_alloc ? fp->point_alloc * 2 : 64;
+		float *xy = realloc(fp->xy, alloc * 2 * sizeof(float));
+		if (xy == NULL) {
+			return false;
+		}
+		fp->xy = xy;
+		fp->point_alloc = alloc;
+	}
+	fp->xy[fp->npoints * 2] = x;
+	fp->xy[fp->npoints * 2 + 1] = y;
+	fp->npoints++;
+	return true;
+}
+
+static bool flat_path_subpath(struct flat_path *fp)
+{
+	if (fp->nsub == fp->sub_alloc) {
+		unsigned int alloc = fp->sub_alloc ? fp->sub_alloc * 2 : 8;
+		unsigned int *start = realloc(fp->start, alloc * sizeof(*start));
+		bool *closed;
+		if (start == NULL) {
+			return false;
+		}
+		fp->start = start;
+		closed = realloc(fp->closed, alloc * sizeof(*closed));
+		if (closed == NULL) {
+			return false;
+		}
+		fp->closed = closed;
+		fp->sub_alloc = alloc;
+	}
+	fp->start[fp->nsub] = fp->npoints;
+	fp->closed[fp->nsub] = false;
+	fp->nsub++;
+	return true;
+}
+
+/** Number of points in subpath i */
+static unsigned int flat_path_count(const struct flat_path *fp, unsigned int i)
+{
+	unsigned int end = (i + 1 < fp->nsub) ? fp->start[i + 1] : fp->npoints;
+	return end - fp->start[i];
+}
+
+/**
+ * Flatten a plotter path (move, line, cubic bezier and close commands) with
+ * its transform applied.
+ */
+static bool
+flat_path_build(struct flat_path *fp, const float *p, unsigned int n,
+		const float t[6])
+{
+	unsigned int i = 0;
+	float cx = 0, cy = 0; /* current point, screen coordinates */
+
+#define TX(x, y) (t[0] * (x) + t[2] * (y) + t[4])
+#define TY(x, y) (t[1] * (x) + t[3] * (y) + t[5])
+
+	while (i < n) {
+		switch ((int)p[i]) {
+		case PLOTTER_PATH_MOVE:
+			if (i + 3 > n || !flat_path_subpath(fp)) {
+				return false;
+			}
+			cx = TX(p[i + 1], p[i + 2]);
+			cy = TY(p[i + 1], p[i + 2]);
+			if (!flat_path_point(fp, cx, cy)) {
+				return false;
+			}
+			i += 3;
+			break;
+
+		case PLOTTER_PATH_CLOSE:
+			if (fp->nsub > 0) {
+				unsigned int s = fp->start[fp->nsub - 1];
+				fp->closed[fp->nsub - 1] = true;
+				/* drawing continues from the subpath's start */
+				cx = fp->xy[s * 2];
+				cy = fp->xy[s * 2 + 1];
+			}
+			i += 1;
+			break;
+
+		case PLOTTER_PATH_LINE:
+			if (i + 3 > n) {
+				return false;
+			}
+			if (fp->nsub == 0 && !flat_path_subpath(fp)) {
+				return false;
+			}
+			cx = TX(p[i + 1], p[i + 2]);
+			cy = TY(p[i + 1], p[i + 2]);
+			if (!flat_path_point(fp, cx, cy)) {
+				return false;
+			}
+			i += 3;
+			break;
+
+		case PLOTTER_PATH_BEZIER: {
+			float x1, y1, x2, y2, x3, y3, len;
+			int steps, k;
+
+			if (i + 7 > n) {
+				return false;
+			}
+			if (fp->nsub == 0 && !flat_path_subpath(fp)) {
+				return false;
+			}
+			x1 = TX(p[i + 1], p[i + 2]);
+			y1 = TY(p[i + 1], p[i + 2]);
+			x2 = TX(p[i + 3], p[i + 4]);
+			y2 = TY(p[i + 3], p[i + 4]);
+			x3 = TX(p[i + 5], p[i + 6]);
+			y3 = TY(p[i + 5], p[i + 6]);
+
+			/* a segment every few pixels of the control polygon */
+			len = fabsf(x1 - cx) + fabsf(y1 - cy) +
+				fabsf(x2 - x1) + fabsf(y2 - y1) +
+				fabsf(x3 - x2) + fabsf(y3 - y2);
+			steps = (int)(len / 3.0f);
+			if (steps < 2) {
+				steps = 2;
+			} else if (steps > 64) {
+				steps = 64;
+			}
+			for (k = 1; k <= steps; k++) {
+				float u = (float)k / (float)steps;
+				float v = 1.0f - u;
+				float b0 = v * v * v, b1 = 3 * v * v * u;
+				float b2 = 3 * v * u * u, b3 = u * u * u;
+				if (!flat_path_point(fp,
+						b0 * cx + b1 * x1 + b2 * x2 + b3 * x3,
+						b0 * cy + b1 * y1 + b2 * y2 + b3 * y3)) {
+					return false;
+				}
+			}
+			cx = x3;
+			cy = y3;
+			i += 7;
+			break;
+		}
+
+		default:
+			return false;
+		}
+	}
+#undef TX
+#undef TY
+	return true;
+}
+
+struct path_crossing {
+	float x;
+	int dir;
+};
+
+/**
+ * Fill a flattened path by scanlines with the non-zero winding rule (every
+ * subpath counts as closed), sampling at pixel centres.
+ */
+static bool
+flat_path_fill(const struct flat_path *fp, nsfb_colour_t colour)
+{
+	nsfb_bbox_t clip;
+	struct path_crossing *cross;
+	float ymin, ymax;
+	int y, y0, y1;
+	unsigned int i;
+
+	if (fp->npoints < 3) {
+		return true;
+	}
+	ymin = ymax = fp->xy[1];
+	for (i = 1; i < fp->npoints; i++) {
+		float py = fp->xy[i * 2 + 1];
+		if (py < ymin) {
+			ymin = py;
+		}
+		if (py > ymax) {
+			ymax = py;
+		}
+	}
+	nsfb_plot_get_clip(nsfb, &clip);
+	y0 = (int)floorf(ymin);
+	y1 = (int)ceilf(ymax);
+	if (y0 < clip.y0) {
+		y0 = clip.y0;
+	}
+	if (y1 > clip.y1) {
+		y1 = clip.y1;
+	}
+	if (y0 >= y1) {
+		return true;
+	}
+
+	/* each edge crosses a scanline at most once */
+	cross = malloc(fp->npoints * sizeof(*cross));
+	if (cross == NULL) {
+		return false;
+	}
+	for (y = y0; y < y1; y++) {
+		float yc = y + 0.5f;
+		unsigned int ncross = 0, s, k;
+		int winding = 0;
+		float span_start = 0;
+
+		for (s = 0; s < fp->nsub; s++) {
+			unsigned int first = fp->start[s];
+			unsigned int count = flat_path_count(fp, s);
+			for (k = 0; k < count; k++) {
+				const float *a = &fp->xy[(first + k) * 2];
+				const float *b = &fp->xy[(first + (k + 1) % count) * 2];
+				if ((a[1] <= yc && b[1] > yc) ||
+				    (b[1] <= yc && a[1] > yc)) {
+					float x = a[0] + (yc - a[1]) *
+						(b[0] - a[0]) / (b[1] - a[1]);
+					unsigned int j = ncross++;
+					/* insertion sort by x */
+					while (j > 0 && cross[j - 1].x > x) {
+						cross[j] = cross[j - 1];
+						j--;
+					}
+					cross[j].x = x;
+					cross[j].dir = (b[1] > a[1]) ? 1 : -1;
+				}
+			}
+		}
+
+		for (k = 0; k < ncross; k++) {
+			int before = winding;
+			winding += cross[k].dir;
+			if (before == 0 && winding != 0) {
+				span_start = cross[k].x;
+			} else if (before != 0 && winding == 0) {
+				nsfb_bbox_t span;
+				span.x0 = (int)ceilf(span_start - 0.5f);
+				span.x1 = (int)ceilf(cross[k].x - 0.5f);
+				span.y0 = y;
+				span.y1 = y + 1;
+				if (span.x1 > span.x0) {
+					nsfb_plot_rectangle_fill(nsfb, &span, colour);
+				}
+			}
+		}
+	}
+	free(cross);
+	return true;
+}
+
+/** Stroke a flattened path with lines of the given width */
+static void
+flat_path_stroke(const struct flat_path *fp, nsfb_plot_pen_t *pen)
+{
+	unsigned int s, k;
+
+	for (s = 0; s < fp->nsub; s++) {
+		unsigned int first = fp->start[s];
+		unsigned int count = flat_path_count(fp, s);
+		unsigned int segments = fp->closed[s] ? count : count - 1;
+		if (count < 2) {
+			continue;
+		}
+		for (k = 0; k < segments; k++) {
+			const float *a = &fp->xy[(first + k) * 2];
+			const float *b = &fp->xy[(first + (k + 1) % count) * 2];
+			nsfb_bbox_t line;
+			line.x0 = (int)floorf(a[0] + 0.5f);
+			line.y0 = (int)floorf(a[1] + 0.5f);
+			line.x1 = (int)floorf(b[0] + 0.5f);
+			line.y1 = (int)floorf(b[1] + 0.5f);
+			nsfb_plot_line(nsfb, &line, pen);
+		}
+	}
+}
